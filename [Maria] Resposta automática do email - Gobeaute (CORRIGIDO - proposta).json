    {
      "parameters": {
        "jsCode": "const d = $input.first().json;\nconst anexos = d.anexos || [];\n\n// Monta o email MIME multipart manualmente\nconst boundary = 'boundary_' + Date.now();\n\nconst toBase64Url = (str) => Buffer.from(str).toString('base64').replace(/\\+/g, '-').replace(/\\//g, '_').replace(/=/g, '');\n\n// CORRIGIDO (18/08/2026): adiciona Cc/Bcc ao cabecalho quando presentes -\n// antes o codigo nem lia esses campos. Gmail API processa Cc/Bcc dentro do\n// MIME 'raw' normalmente (Bcc e removido do que os outros destinatarios veem,\n// igual SMTP padrao).\nconst cabecalhos = [\n  'MIME-Version: 1.0',\n  'To: ' + d.para,\n];\nif (d.cc) cabecalhos.push('Cc: ' + d.cc);\nif (d.bcc) cabecalhos.push('Bcc: ' + d.bcc);\ncabecalhos.push('Subject: ' + d.assunto);\ncabecalhos.push('Content-Type: multipart/mixed; boundary=\"' + boundary + '\"');\ncabecalhos.push('');\n\nlet mime = cabecalhos.join('\\r\\n') + [\n  '--' + boundary,\n  'Content-Type: text/plain; charset=utf-8',\n  '',\n  d.mensagem,\n  ''\n].join('\\r\\n');\n\nanexos.forEach(function(anexo) {\n  mime += [\n    '--' + boundary,\n    'Content-Type: ' + (anexo.type || 'application/octet-stream') + '; name=\"' + anexo.name + '\"',\n    'Content-Transfer-Encoding: base64',\n    'Content-Disposition: attachment; filename=\"' + anexo.name + '\"',\n    '',\n    anexo.data,\n    ''\n  ].join('\\r\\n');\n});\n\nmime += '--' + boundary + '--';\n\nconst rawEmail = toBase64Url(mime);\n\nreturn [{ json: { ...d, rawEmail } }];"
      },
